# HearMeOut — contoh konfigurasi (salin ke .env lalu isi)
LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=sk-...

# API key Bob non-interaktif (Scope: Inference) — bob.ibm.com → Account → API Keys
BOB_API_KEY=bob_...
# Guardrail bob run
BOB_MAX_TURNS=6

# Backend history (MERN)
MONGODB_URI=mongodb://127.0.0.1:27017/briefme
PORT=8790
HISTORY_URL=http://127.0.0.1:8790
